# ─── Database ──────────────────────────────────────────────
POSTGRES_USER=refund_desk
POSTGRES_PASSWORD=refund_desk_dev
POSTGRES_DB=refund_desk

# ─── API ───────────────────────────────────────────────────
API_PORT=4000
LOG_LEVEL=info

# ─── AI ────────────────────────────────────────────────────
# Leave ANTHROPIC_API_KEY empty to run with the built-in mock provider.
# The whole app still works; replies are templated instead of generated.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
AI_TIMEOUT_MS=15000

# Shared secret the web app sends to the admin API (min 12 chars)
ADMIN_API_KEY=local-dev-admin-key
