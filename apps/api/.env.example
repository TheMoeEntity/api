# Used when running the API or Prisma CLI directly on your machine
# (outside Docker). Points at the Postgres container's published port.
DATABASE_URL=postgresql://refund_desk:refund_desk_dev@localhost:5432/refund_desk
NODE_ENV=development
API_PORT=4000
LOG_LEVEL=debug
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
AI_TIMEOUT_MS=15000

# Shared secret the web app sends to the admin API (min 12 chars)
ADMIN_API_KEY=local-dev-admin-key
