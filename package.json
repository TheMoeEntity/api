{
  "name": "refund-desk",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "build:shared": "pnpm --filter @refund-desk/shared build",
    "typecheck": "pnpm build:shared && pnpm -r typecheck",
    "test": "pnpm build:shared && pnpm --filter @refund-desk/api test",
    "dev:api": "pnpm build:shared && pnpm --filter @refund-desk/api dev"
  }
}
